# ─── Server Configuration ──────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database Configuration (PostgreSQL 15 + pgvector) ─────────────
# Local Docker instance:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safebite?schema=public
# AWS RDS instance (production):
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/safebite?sslmode=require

# ─── JWT Authentication ────────────────────────────────────────────
# 90-day JWT sessions for seamless mobile authentication
JWT_SECRET=super-secret-jwt-key-safebite-backend-change-in-prod
JWT_EXPIRES_IN=90d

# ─── Security & Rate Limiting ──────────────────────────────────────
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── AWS S3 Configuration ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=safebite-assets

# ─── Email Delivery (Mailtrap API + Optional SMTP Fallback) ────────
# Primary: Mailtrap Email Sending API (uses your verified sending domain)
MAILTRAP_API_TOKEN=your-mailtrap-api-token
EMAIL_FROM_ADDRESS=noreply@safebite.live
EMAIL_FROM_NAME=SafeBite
# Optional: Mailtrap Sandbox ID (set only when testing in Mailtrap Sandbox mode)
# MAILTRAP_SANDBOX_ID=your-sandbox-inbox-id

# Optional Fallback: Standard SMTP server (used only if MAILTRAP_API_TOKEN is unset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username-or-email
# SMTP_PASS=your-smtp-app-password-or-api-key
# SMTP_FROM="SafeBite <noreply@safebite.live>"

# ─── AI Providers (RAG Assistant) ──────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
