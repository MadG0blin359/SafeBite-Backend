{
  "openapi": "3.0.3",
  "info": {
    "title": "SafeBite API",
    "version": "1.0.0",
    "description": "AI-Powered Food Safety Intelligence REST API for Pakistani Packaged Foods (SRS v4.1 compliant)."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Liveness and PostgreSQL/pgvector readiness probes"
    },
    {
      "name": "Auth",
      "description": "Native JWT authentication and user profile management"
    },
    {
      "name": "Storage",
      "description": "AWS S3 image uploads and presigned URLs"
    },
    {
      "name": "User Data",
      "description": "Scan/search history, favorites, watchlist, and consented health profile"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Native JWT Bearer token (90-day mobile session)"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "statusCode": {
            "type": "integer",
            "example": 400
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "Jane Doe"
          },
          "role": {
            "type": "string",
            "enum": ["USER", "ADMIN"],
            "example": "USER"
          },
          "healthConsent": {
            "type": "boolean",
            "example": false
          },
          "consentDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "healthTags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PREGNANCY",
                "INFANT",
                "KIDNEY_ISSUE",
                "HYPERTENSION",
                "DIABETES",
                "CELIAC",
                "NUT_ALLERGY",
                "HEART_CONDITION",
                "ELDERLY",
                "GENERAL_POPULATION"
              ]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SignUpRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 72,
            "example": "Secret123!"
          },
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70,
            "description": "Alphabetic letters across supported scripts with single spaces, hyphens, or apostrophes. Emojis, digits, symbols, and invisible characters are rejected.",
            "example": "Jane Doe"
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "example": "Secret123!"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70,
            "description": "Alphabetic letters across supported scripts with single spaces, hyphens, or apostrophes. Emojis, digits, symbols, and invisible characters are rejected.",
            "example": "Jane O'Connor"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          }
        }
      },
      "SignedUploadRequest": {
        "type": "object",
        "required": ["fileName", "mimeType"],
        "properties": {
          "fileName": {
            "type": "string",
            "maxLength": 100,
            "example": "packaging.jpg"
          },
          "mimeType": {
            "type": "string",
            "enum": ["image/jpeg", "image/png", "image/webp"],
            "example": "image/jpeg"
          },
          "folder": {
            "type": "string",
            "enum": ["products", "users", "research"],
            "default": "products"
          }
        }
      },
      "SignedUrlRequest": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 255,
            "example": "products/image-uuid.jpg"
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 3600
          }
        }
      },
      "DeleteFilesRequest": {
        "type": "object",
        "required": ["paths"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string"
            },
            "example": ["users/user-uuid/photo.jpg"]
          }
        }
      },
      "RecordScanRequest": {
        "type": "object",
        "required": ["productId"],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RecordSearchRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "Olper's Milk"
          }
        }
      },
      "HealthConsentRequest": {
        "type": "object",
        "required": ["consent"],
        "properties": {
          "consent": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "HealthTagsRequest": {
        "type": "object",
        "required": ["tags"],
        "properties": {
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "enum": [
                "PREGNANCY",
                "INFANT",
                "KIDNEY_ISSUE",
                "HYPERTENSION",
                "DIABETES",
                "CELIAC",
                "NUT_ALLERGY",
                "HEART_CONDITION",
                "ELDERLY",
                "GENERAL_POPULATION"
              ]
            },
            "example": ["PREGNANCY", "INFANT"]
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is healthy and running"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["System"],
        "summary": "Readiness probe",
        "description": "Checks connectivity to PostgreSQL database and pgvector extension",
        "responses": {
          "200": {
            "description": "Service, PostgreSQL, and pgvector are ready"
          },
          "503": {
            "description": "Database is unavailable"
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully with 90-day JWT"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "An account with this email already exists"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate user and receive 90-day JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Invalid email or password"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Initiate password reset workflow",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic acknowledgement returned without leaking account existence"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user profile details"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "patch": {
        "tags": ["Auth"],
        "summary": "Update authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Acknowledge user logout",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Signed out successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/storage/upload": {
      "post": {
        "tags": ["Storage"],
        "summary": "Upload an image directly through server buffer to AWS S3",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG, PNG, or WebP image (max 10MB)"
                  },
                  "folder": {
                    "type": "string",
                    "enum": ["products", "users", "research"],
                    "default": "products"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully to S3"
          },
          "400": {
            "description": "Invalid file type, folder, or missing file"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/storage/signed-upload": {
      "post": {
        "tags": ["Storage"],
        "summary": "Request a presigned PUT upload URL for direct mobile-to-S3 upload",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned S3 upload URL returned"
          },
          "400": {
            "description": "Invalid filename, MIME type, or folder"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/storage/signed-url": {
      "post": {
        "tags": ["Storage"],
        "summary": "Generate a presigned download URL for an S3 object",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedUrlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed download URL returned"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (outside permitted folder/user scope)"
          }
        }
      }
    },
    "/api/storage/files": {
      "get": {
        "tags": ["Storage"],
        "summary": "List files within permitted S3 folder",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "folder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "products"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of S3 objects"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (non-admin access restricted)"
          }
        }
      },
      "delete": {
        "tags": ["Storage"],
        "summary": "Delete files from S3 storage (user-scoped or Admin)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteFilesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Files deleted successfully"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (cannot delete files outside own user folder)"
          }
        }
      }
    },
    "/api/user/history": {
      "get": {
        "tags": ["User Data"],
        "summary": "Get user scan and search history (FR-12)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User history retrieved"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "delete": {
        "tags": ["User Data"],
        "summary": "Complete scan & search history wipe (NFR-PR-02)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "All scan and search history deleted"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/user/history/scan": {
      "post": {
        "tags": ["User Data"],
        "summary": "Record a product barcode scan in history (FR-12-02)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordScanRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product scan recorded"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/api/user/history/search": {
      "post": {
        "tags": ["User Data"],
        "summary": "Record a text search query in history (FR-12-01)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordSearchRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Search query recorded"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/user/favorites": {
      "get": {
        "tags": ["User Data"],
        "summary": "List user favorite products (FR-13-03)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Favorites retrieved"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/user/favorites/{productId}": {
      "post": {
        "tags": ["User Data"],
        "summary": "Add product to favorites (FR-13-01)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Product added to favorites"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product not found"
          }
        }
      },
      "delete": {
        "tags": ["User Data"],
        "summary": "Remove product from favorites (FR-13-05)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product removed from favorites"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product was not in favorites"
          }
        }
      }
    },
    "/api/user/watchlist": {
      "get": {
        "tags": ["User Data"],
        "summary": "List user watchlist with grade change alerts (FR-13-07)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Watchlist items retrieved"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/user/watchlist/{productId}": {
      "post": {
        "tags": ["User Data"],
        "summary": "Add product to watchlist (FR-13-02)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Product added to watchlist"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product not found"
          }
        }
      },
      "delete": {
        "tags": ["User Data"],
        "summary": "Remove product from watchlist (FR-13-06)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product removed from watchlist"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product was not in watchlist"
          }
        }
      }
    },
    "/api/user/health-profile": {
      "get": {
        "tags": ["User Data"],
        "summary": "Get health profile and consented tags (FR-16-01)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Health profile retrieved"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "delete": {
        "tags": ["User Data"],
        "summary": "Revoke consent and delete health tags (FR-16-02)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Consent revoked and tags cleared"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/user/health-profile/consent": {
      "put": {
        "tags": ["User Data"],
        "summary": "Update explicit health consent state (FR-16-02)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HealthConsentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Health consent updated"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/user/health-profile/tags": {
      "put": {
        "tags": ["User Data"],
        "summary": "Update consented health-context tags (FR-16-01)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HealthTagsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Health tags updated"
          },
          "400": {
            "description": "Validation error (unrecognized tag)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (explicit health consent required before saving tags)"
          }
        }
      }
    }
  }
}
